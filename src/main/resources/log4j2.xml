<Configuration status="warn" name="MyApp" packages="">
    <Appenders>
        <RollingFile name="RollingFile" fileName="logs/hippodrome.log" filePattern="logs/hippodrome-%d{MM-dd-yyyy}-%i.log">
            <PatternLayout> <Pattern>%d %p %c{1.} [%t] %m%n</Pattern> </PatternLayout>
            <Policies> <TimeBasedTriggeringPolicy interval = "1"  /></Policies>
            <DefaultRolloverStrategy max="30">
                <Delete basePath="logs/archive" maxDepth="1">
                <IfFileName glob=" hippodrome-*.log"/>
                <IfLastModified age = "7d"/>
            </Delete>
        </DefaultRolloverStrategy>
        </RollingFile>

    </Appenders>
    <Loggers>
        <Root level="debug">
            <AppenderRef ref="RollingFile"/>
        </Root>
    </Loggers>


</Configuration>